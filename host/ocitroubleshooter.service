[Unit]
Description=OCI application troubleshooter
Wants=network-online.target
Requires=var-lib-ocitroubleshooter-data.mount
BindsTo=var-lib-ocitroubleshooter-data.mount
After=network-online.target var-lib-ocitroubleshooter-data.mount
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=/opt/ocitroubleshooter
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStartPre=/usr/bin/python3 -m troubleshooter_host prepare
ExecStart=/usr/bin/python3 -m troubleshooter_host run
ExecStopPost=/usr/bin/python3 -m troubleshooter_host stop
Restart=on-failure
RestartSec=60
TimeoutStartSec=1200
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
